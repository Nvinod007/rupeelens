# Copy to apps/rupeelens-api/.env (never commit .env)

# --- Runtime ---------------------------------------------------------------
# NODE_ENV=development            # development | production | test
PORT=4001
# Comma-separated browser origins allowed by CORS (localhost is auto-allowed outside production)
# CORS_ORIGINS=https://app.rupeelens.example

# --- Security (required) ---------------------------------------------------
# Derives the AES-256-GCM key that encrypts users' BYOK Gemini keys (min 16 chars)
KEY_ENCRYPTION_SECRET=change-me-min-16-chars

# --- Supabase (REQUIRED for login: the API verifies Google sessions with it) -
# Set BOTH. Without them every protected route returns 503.
SUPABASE_URL=https://your-project.supabase.co
# Service role / secret key (not the anon publishable key)
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage ---------------------------------------------------------------
# auto     -> Supabase when configured, otherwise in-memory
# memory   -> force in-memory (use if REST fails with PGRST002)
# supabase -> require Supabase
# TRANSACTIONS_STORAGE=auto

# --- Gemini ----------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TEMPERATURE=0.2
# GEMINI_REQUEST_TIMEOUT_MS=20000
